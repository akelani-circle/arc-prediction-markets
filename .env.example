# Deployer wallet private key (for contract deployment)
PRIVATE_KEY=your_private_key_here

# Alchemy RPC URL (used by both Hardhat and the frontend). Optional - falls back to
# the public Arc Testnet RPC (https://rpc.testnet.arc.io) if left unset.
# NEXT_PUBLIC_ALCHEMY_RPC_URL=https://your-alchemy-rpc-url-here

# Circle modular wallets (required for passkey wallet support).
# Client key: Circle Console > Modular Wallets. Its allowed domain must include `localhost`.
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=your_circle_client_key_here
NEXT_PUBLIC_CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# Contract addresses (auto-written by deploy script)
# NEXT_PUBLIC_MARKET_ADDRESS=0x...
# NEXT_PUBLIC_AMM_ADDRESS=0x...
# NEXT_PUBLIC_ARCT_ADDRESS=0x...
# NEXT_PUBLIC_OO_V2_ADDRESS=0x...
# NEXT_PUBLIC_FINDER_ADDRESS=0x...
# NEXT_PUBLIC_MOCK_ORACLE_ADDRESS=0x...
